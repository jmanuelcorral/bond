#!/usr/bin/env node
// Pinta el logo de BOND en la terminal (lib/bond-logo.mts).
//
// Uso: bond-logo [--small [texto]] [--width N]
//   sin opciones: logo al ancho de la terminal (ancho, compacto o mínimo según quepa)
//   --small:      una línea "007 BOND ╱╱╱", con texto opcional detrás
import { renderLogo, renderSmall, randomStretch } from "../lib/bond-logo.mts";

const args = process.argv.slice(2);
const wIdx = args.indexOf("--width");
const width = wIdx >= 0 ? Number(args[wIdx + 1]) : process.stdout.columns || 80;
if (!Number.isInteger(width) || width <= 0) {
	console.error("--width necesita un entero > 0");
	process.exit(2);
}

if (args.includes("--small")) {
	const text = args.filter((a, i) => a !== "--small" && a !== "--width" && i !== wIdx + 1 || wIdx < 0 && a !== "--small").join(" ");
	console.log(renderSmall(width, text));
} else {
	console.log(renderLogo({ width, version: process.env.BOND_VERSION ?? "", stretch: randomStretch() }).join("\n"));
}

#!/usr/bin/env bash
# Lanza un equipo de agentes sobre un repo: uno por rama, cada uno en su worktree y en su
# workspace de Herdr (con `pidev --worktree`). Lo que hace cada agente se lo dices después
# (herdr agent prompt, o desde un pi con /team).
set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
KIND="pi"
BASE_REF=""
PROJECT=""
SPECS=()
PASS=()
AGENT_ARGS=()

log() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Uso: piteam <repo> <rama[:kind]>... [opciones] [-- argumentos de los agentes]

Un agente por rama, cada uno en su worktree de git y su workspace de Herdr
(pi:<repo>/<rama>). Las ramas que no existen se crean desde --base (o desde HEAD).
Si el workspace de una rama ya existe, se reutiliza.

  -k, --kind <kind>    Agente por defecto (defecto: pi); rama:kind lo cambia para esa rama
  -b, --base <ref>     Ref de la que salen las ramas nuevas
  --trust-repository   Se pasa a `herdr worktree` (solo en repos que hayas revisado)
  -h, --help           Esta ayuda

Ejemplos:
  piteam ~/gitrepos/miapp feat/login feat/api:claude --base main
  piteam . spike-a spike-b spike-c -- --model halo/flash-halogen

Después, para cada agente:
  herdr agent prompt <agente> "la tarea" --wait
  pistatus                      # estado de todos
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -k | --kind) [ $# -ge 2 ] || die "$1 necesita un valor"; KIND="$2"; shift 2 ;;
    -b | --base) [ $# -ge 2 ] || die "$1 necesita un valor"; BASE_REF="$2"; shift 2 ;;
    --trust-repository) PASS+=(--trust-repository); shift ;;
    -h | --help) usage; exit 0 ;;
    --) shift; AGENT_ARGS=("$@"); break ;;
    -*) die "opción desconocida: $1 (--help para ver las opciones)" ;;
    *)
      if [ -z "$PROJECT" ]; then PROJECT="$1"; else SPECS+=("$1"); fi
      shift
      ;;
  esac
done

[ -n "$PROJECT" ] || { usage >&2; exit 2; }
[ ${#SPECS[@]} -gt 0 ] || die "indica al menos una rama (rama o rama:kind)"
[ -x "$BIN_DIR/pidev" ] || die "no encuentro pidev junto a piteam ($BIN_DIR)"

declare -A seen=()
for spec in "${SPECS[@]}"; do
  branch="${spec%%:*}"
  [ -n "$branch" ] || die "rama vacía en '$spec'"
  [ -z "${seen[$branch]:-}" ] || die "rama repetida: $branch"
  seen[$branch]=1
done

failed=()
for spec in "${SPECS[@]}"; do
  branch="${spec%%:*}"
  kind="$KIND"
  [ "$spec" = "$branch" ] || kind="${spec#*:}"
  log "[$branch] $kind"
  args=("$PROJECT" --worktree "$branch" --kind "$kind" --no-focus "${PASS[@]}")
  [ -z "$BASE_REF" ] || args+=(--base "$BASE_REF")
  [ ${#AGENT_ARGS[@]} -eq 0 ] || args+=(-- "${AGENT_ARGS[@]}")
  # La salida detallada de cada pidev sobra aquí: el resumen final lo cubre.
  if ! out="$("$BIN_DIR/pidev" "${args[@]}" 2>&1)"; then
    printf '%s\n' "$out" | tail -3 >&2
    failed+=("$branch")
  else
    printf '%s\n' "$out" | grep -E 'aviso|Ya hay workspace' >&2 || true
  fi
done

root="$(git -C "$PROJECT" rev-parse --show-toplevel 2>/dev/null)" || root="$(cd -- "$PROJECT" && pwd)"
repo="$(basename "$root")"
echo
printf '  '; "$BIN_DIR/bond-logo" --small --width 60 "equipo en $repo" 2>/dev/null || echo "007 BOND · equipo en $repo"
echo
"$BIN_DIR/pistatus" | {
  # Solo los agentes de este repo: su cwd es un worktree bajo ~/.herdr/worktrees/<repo>/.
  IFS= read -r header
  printf '%s\n' "$header"
  grep -F "/worktrees/$repo/" || true
}

if [ ${#failed[@]} -gt 0 ]; then
  die "no se pudo montar: ${failed[*]}"
fi
cat <<'EOF'

  Repartir trabajo:  herdr agent prompt <agente> "la tarea" --wait --timeout 900000
  Leer resultado:    herdr agent read <agente> --source recent-unwrapped --lines 200
  Quitar un worktree (borra la carpeta, no la rama): herdr worktree remove --workspace <id>
EOF

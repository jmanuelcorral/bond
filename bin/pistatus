#!/usr/bin/env bash
# Estado de los agentes que Herdr tiene vivos, con su panel y su directorio.
set -euo pipefail

die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Uso: pistatus [-j|--json]

Lista los agentes vivos que Herdr reconoce: nombre, kind, estado, cwd y panel.

  -j, --json   Imprime la respuesta cruda de `herdr agent list`
  -h, --help   Esta ayuda

Estados: idle, working, blocked (esperando respuesta tuya), done, unknown.
EOF
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
esac

command -v herdr >/dev/null 2>&1 || die "herdr no está en el PATH"
command -v jq >/dev/null 2>&1 || die "jq no está en el PATH"

raw="$(herdr agent list 2>/dev/null)" || die "no hay servidor de Herdr accesible"

if [ "${1:-}" = "-j" ] || [ "${1:-}" = "--json" ]; then
  jq . <<<"$raw"
  exit 0
fi

count="$(jq '.agents | length' <<<"$raw")"
if [ "$count" = "0" ]; then
  echo "Sin agentes vivos. Lanza uno con: pidev <directorio>"
  exit 0
fi

{
  printf 'AGENTE\tKIND\tESTADO\tCWD\tPANEL\n'
  jq -r '
    .agents[]
    | [ .name // "(sin nombre)",
        .agent // "?",
        .agent_status // "?",
        (.cwd // .foreground_cwd // "-"),
        .pane_id ]
    | @tsv
  ' <<<"$raw"
} | column -t -s "$(printf '\t')"

#!/usr/bin/env node
"use strict";
const { spawn } = require("node:child_process");
const { existsSync } = require("node:fs");
const { join } = require("node:path");

function findBondApp() {
	try {
		return require.resolve("@jmanuelcorral/bond-app/bin/bond-app.js");
	} catch {}
	const candidates = [
		join(__dirname, "..", "node_modules", "@jmanuelcorral", "bond-app", "bin", "bond-app.js"),
		join(__dirname, "..", "..", "bond-app", "bin", "bond-app.js"),
	];
	for (const p of candidates) {
		if (existsSync(p)) return p;
	}
	console.error("bond-app no encontrado. Instala @jmanuelcorral/bond-app o ejecuta bond desde el hub.");
	process.exit(1);
}

const target = findBondApp();
const child = spawn(process.execPath, [target, ...process.argv.slice(2)], {
	stdio: "inherit",
});
child.on("exit", (code, signal) => {
	if (signal) process.kill(process.pid, signal);
	process.exit(code ?? 0);
});

{
	"compilerOptions": {
		"target": "es2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node", "bun"]
	},
	"include": ["cli", "lib", "scripts", "test"],
	"exclude": ["cli/assets.gen.mts"]
}
